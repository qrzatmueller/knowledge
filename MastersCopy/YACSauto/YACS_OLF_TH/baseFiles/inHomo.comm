
DEBUT(LANG='FR')


# coeficient for sinus function
A = 0.8

# nominal eta
etaa = 0.3

# nominal E 
E = 210000000000.0

# wavenumber for sinus function
k =6283.185307179586

mesh = LIRE_MAILLAGE(identifier='4:1',
                     UNITE=20)

model = AFFE_MODELE(identifier='5:1',
                    AFFE=_F(MODELISATION='POU_D_E',
                            PHENOMENE='MECANIQUE',
                            TOUT='OUI'),
                    MAILLAGE=mesh)

elemprop = AFFE_CARA_ELEM(identifier='6:1',
                          MODELE=model,
                          POUTRE=_F(CARA=('HY', 'HZ'),
                                    GROUP_MA=('EBfullEdge', ),
                                    SECTION='RECTANGLE',
                                    VALE=(0.03, 0.001)))

materConst = DEFI_MATERIAU(identifier='7:1',
                           ELAS=_F(AMOR_HYST=0.8,
                                   E=210000000000.0,
                                   NU=0.3,
                                   RHO=7850.0))

listr = DEFI_LIST_REEL(identifier='8:1',
                       DEBUT=30.0,
                       INTERVALLE=_F(JUSQU_A=1500.0,
                                     PAS=1.0))

funcE2 = DEFI_CONSTANTE(identifier='9:1',
                        VALE=E,
                        )

funcRho2 = DEFI_CONSTANTE(identifier='10:1',
                          VALE=7850.0)

funcNu2 = DEFI_CONSTANTE(identifier='11:1',
                         VALE=0.3)

formSin = FORMULE(identifier='12:1',
                  NOM_PARA=('X', ),
                  VALE='etaa+(A*sin(k*X))',
                  A=A,
                  k=k,
                  etaa=etaa)

mater = DEFI_MATERIAU(identifier='13:1',
                      ELAS_FO=_F(AMOR_HYST=formSin,
                                 E=funcE2,
                                 NU=funcNu2,
                                 RHO=funcRho2))

fieldmat = AFFE_MATERIAU(identifier='14:1',
                         AFFE=_F(MATER=(mater, ),
                                 TOUT='OUI'),
                         MAILLAGE=mesh,
                         MODELE=model)

load = AFFE_CHAR_MECA(identifier='15:1',
                      DDL_IMPO=_F(DRX=0.0,
                                  DRZ=0.0,
                                  DX=0.0,
                                  DY=0.0,
                                  GROUP_NO=('EBEdgeEnc', )),
                      MODELE=model)

baseEx = AFFE_CHAR_MECA(identifier='16:1',
                        DDL_IMPO=_F(DZ=1.0,
                                    GROUP_NO=('EBEdgeEnc', )),
                        MODELE=model)

ASSEMBLAGE(identifier='0:2',
           CARA_ELEM=elemprop,
           CHAM_MATER=fieldmat,
           CHARGE=(load, baseEx),
           MATR_ASSE=(_F(MATRICE=CO('M'),
                         OPTION='MASS_MECA'),
                      _F(MATRICE=CO('K'),
                         OPTION='RIGI_MECA'),
                      _F(MATRICE=CO('KH'),
                         OPTION='RIGI_MECA_HYST')),
           MODELE=model,
           NUME_DDL=CO('nddl'))

resharm = DYNA_VIBRA(identifier='4:2',
                     BASE_CALCUL='PHYS',
                     CARA_ELEM=elemprop,
                     CHAM_MATER=fieldmat,
                     EXCIT=_F(CHARGE=baseEx,
                              COEF_MULT=0.0001),
                     LIST_FREQ=listr,
                     MATR_MASS=M,
                     MATR_RIGI=KH,
                     MODELE=model,
                     TYPE_CALCUL='HARM')

fend = RECU_FONCTION(identifier='0:3',
                     GROUP_NO=('EBEdgeFree', ),
                     NOM_CHAM='VITE',
                     NOM_CMP='DZ',
                     RESULTAT=resharm)

func1 = RECU_FONCTION(identifier='1:3',
                      GROUP_NO=('Group_1', ),
                      NOM_CHAM='VITE',
                      NOM_CMP='DZ',
                      RESULTAT=resharm)

func2 = RECU_FONCTION(identifier='2:3',
                      GROUP_NO=('Group_2', ),
                      NOM_CHAM='VITE',
                      NOM_CMP='DZ',
                      RESULTAT=resharm)

func3 = RECU_FONCTION(identifier='3:3',
                      GROUP_NO=('Group_3', ),
                      NOM_CHAM='VITE',
                      NOM_CMP='DZ',
                      RESULTAT=resharm)

func4 = RECU_FONCTION(identifier='4:3',
                      GROUP_NO=('Group_4', ),
                      NOM_CHAM='VITE',
                      NOM_CMP='DZ',
                      RESULTAT=resharm)

func5 = RECU_FONCTION(identifier='5:3',
                      GROUP_NO=('Group_5', ),
                      NOM_CHAM='VITE',
                      NOM_CMP='DZ',
                      RESULTAT=resharm)

func6 = RECU_FONCTION(identifier='6:3',
                      GROUP_NO=('Group_6', ),
                      NOM_CHAM='VITE',
                      NOM_CMP='DZ',
                      RESULTAT=resharm)

func7 = RECU_FONCTION(identifier='7:3',
                      GROUP_NO=('Group_7', ),
                      NOM_CHAM='VITE',
                      NOM_CMP='DZ',
                      RESULTAT=resharm)

func8 = RECU_FONCTION(identifier='8:3',
                      GROUP_NO=('Group_8', ),
                      NOM_CHAM='VITE',
                      NOM_CMP='DZ',
                      RESULTAT=resharm)

func9 = RECU_FONCTION(identifier='9:3',
                      GROUP_NO=('Group_9', ),
                      NOM_CHAM='VITE',
                      NOM_CMP='DZ',
                      RESULTAT=resharm)

func10 = RECU_FONCTION(identifier='10:3',
                       GROUP_NO=('Group_10', ),
                       NOM_CHAM='VITE',
                       NOM_CMP='DZ',
                       RESULTAT=resharm)

func11 = RECU_FONCTION(identifier='11:3',
                       GROUP_NO=('Group_11', ),
                       NOM_CHAM='VITE',
                       NOM_CMP='DZ',
                       RESULTAT=resharm)

func12 = RECU_FONCTION(identifier='12:3',
                       GROUP_NO=('Group_12', ),
                       NOM_CHAM='VITE',
                       NOM_CMP='DZ',
                       RESULTAT=resharm)

func13 = RECU_FONCTION(identifier='13:3',
                       GROUP_NO=('Group_13', ),
                       NOM_CHAM='VITE',
                       NOM_CMP='DZ',
                       RESULTAT=resharm)

func14 = RECU_FONCTION(identifier='14:3',
                       GROUP_NO=('Group_14', ),
                       NOM_CHAM='VITE',
                       NOM_CMP='DZ',
                       RESULTAT=resharm)

func15 = RECU_FONCTION(identifier='15:3',
                       GROUP_NO=('Group_15', ),
                       NOM_CHAM='VITE',
                       NOM_CMP='DZ',
                       RESULTAT=resharm)

func16 = RECU_FONCTION(identifier='16:3',
                       GROUP_NO=('Group_16', ),
                       NOM_CHAM='VITE',
                       NOM_CMP='DZ',
                       RESULTAT=resharm)

func17 = RECU_FONCTION(identifier='17:3',
                       GROUP_NO=('Group_17', ),
                       NOM_CHAM='VITE',
                       NOM_CMP='DZ',
                       RESULTAT=resharm)

func18 = RECU_FONCTION(identifier='18:3',
                       GROUP_NO=('Group_18', ),
                       NOM_CHAM='VITE',
                       NOM_CMP='DZ',
                       RESULTAT=resharm)

func19 = RECU_FONCTION(identifier='19:3',
                       GROUP_NO=('Group_19', ),
                       NOM_CHAM='VITE',
                       NOM_CMP='DZ',
                       RESULTAT=resharm)

func20 = RECU_FONCTION(identifier='20:3',
                       GROUP_NO=('Group_20', ),
                       NOM_CHAM='VITE',
                       NOM_CMP='DZ',
                       RESULTAT=resharm)

func21 = RECU_FONCTION(identifier='21:3',
                       GROUP_NO=('Group_21', ),
                       NOM_CHAM='VITE',
                       NOM_CMP='DZ',
                       RESULTAT=resharm)

func22 = RECU_FONCTION(identifier='22:3',
                       GROUP_NO=('Group_22', ),
                       NOM_CHAM='VITE',
                       NOM_CMP='DZ',
                       RESULTAT=resharm)

func23 = RECU_FONCTION(identifier='23:3',
                       GROUP_NO=('Group_23', ),
                       NOM_CHAM='VITE',
                       NOM_CMP='DZ',
                       RESULTAT=resharm)

func24 = RECU_FONCTION(identifier='24:3',
                       GROUP_NO=('Group_24', ),
                       NOM_CHAM='VITE',
                       NOM_CMP='DZ',
                       RESULTAT=resharm)

IMPR_FONCTION(identifier='25:3',
              COURBE=(_F(FONCTION=func1),
                      _F(FONCTION=func2),
                      _F(FONCTION=func3),
                      _F(FONCTION=func4),
                      _F(FONCTION=func5),
                      _F(FONCTION=func6),
                      _F(FONCTION=func7),
                      _F(FONCTION=func8),
                      _F(FONCTION=func9),
                      _F(FONCTION=func10),
                      _F(FONCTION=func11),
                      _F(FONCTION=func12),
                      _F(FONCTION=func13),
                      _F(FONCTION=func14),
                      _F(FONCTION=func15),
                      _F(FONCTION=func16),
                      _F(FONCTION=func17),
                      _F(FONCTION=func18),
                      _F(FONCTION=func19),
                      _F(FONCTION=func20),
                      _F(FONCTION=func21),
                      _F(FONCTION=func22),
                      _F(FONCTION=func23),
                      _F(FONCTION=func24)),
              FORMAT='TABLEAU',
              UNITE=4)

fend2 = RECU_FONCTION(identifier='26:3',
                      GROUP_NO=('EBEdgeFree', ),
                      NOM_CHAM='VITE',
                      NOM_CMP='DY',
                      RESULTAT=resharm)

IMPR_FONCTION(identifier='27:3',
              COURBE=(_F(FONCTION=fend,
                         MARQUEUR=0,
                         STYLE=1),
                      _F(FONCTION=fend2)),
              FORMAT='TABLEAU',
              UNITE=8)

IMPR_FONCTION(identifier='28:3',
              COURBE=(_F(FONCTION=func12),
                      _F(FONCTION=func24)),
              UNITE=2)

FIN()
